# Copy to .env and replace both placeholders. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Public origins allowed for browser form POSTs (CSRF). Behind Render's proxy,
# set this to your origin, e.g. .onrender.com. Local development leaves it empty.
CSRF_TRUSTED_ORIGINS=
# Browser origins allowed to call the API cross-origin (the React frontend).
# Comma-separated, e.g. http://localhost:5173,https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=
# Match your existing PostgreSQL server; URL-encode special password characters.
DATABASE_URL=postgresql://mobility:replace-with-a-local-password@127.0.0.1:5432/mobility_finance

# Credentials for the docker-compose PostgreSQL container (local demo only).
# Compose builds DATABASE_URL itself; these do not affect a native setup.
POSTGRES_DB=mobility_finance
POSTGRES_USER=mobility
POSTGRES_PASSWORD=mobility

# Paystack TEST mode keys only (sk_test_/pk_test_). Never use live keys.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Signs the local mobile-money simulator's callbacks (demo only).
MOCK_MOMO_WEBHOOK_SECRET=momo-dev-secret

# Local Mosquitto broker for vehicle telemetry (Phase 4).
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
