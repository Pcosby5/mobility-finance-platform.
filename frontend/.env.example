# Copy to frontend/.env.local for local development, or set these in your
# hosting provider's dashboard (Vercel -> Project -> Settings -> Environment
# Variables) for production. Vite inlines VITE_* vars at build time, so
# changing them requires a rebuild/redeploy.

# Absolute origin of the Django API. Leave EMPTY for `npm run dev`: Vite's
# dev proxy already forwards /api to the local backend. Production must be
# the deployed API origin, e.g.:
#   VITE_API_BASE_URL=https://mobility-finance-api.onrender.com
VITE_API_BASE_URL=https://mobility-finance-platform.onrender.com
